{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--extension"]
    }
  },
  "tools": {
    "context7*": false,
    "playwright*": false
  },
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "ask",
    "question": "allow",
    "read": "allow",
    "skill": "allow"
  },
  "plugin": ["opencode-cmux"]
}
