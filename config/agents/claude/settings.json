{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "jabba-the-hutt",
  "permissions": {
    "allow": [
      "Agent(boba-fett)",
      "Agent(zuckuss)",
      "Agent(4-lom)",
      "Agent(dengar)",
      "Agent(ig-88)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(tree:*)",
      "Bash(which:*)",
      "Bash(sort:*)",
      "Bash(cat:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*secret*)",
      "Read(**/*credential*)"
    ]
  }
}
