# {{ ansible_managed }}
COLLIE_INSTANCE={{ collie_instance.name }}
COLLIE_MUX=herdr
COLLIE_HOST=127.0.0.1
COLLIE_PORT={{ collie_instance.port }}
COLLIE_SKIP_SERVE=1
COLLIE_TELEMETRY=0
COLLIE_PUBLIC_HOSTS={{ collie_instance.origin | urlsplit('netloc') }}
COLLIE_ALLOWED_ORIGINS={{ collie_instance.origin }}
COLLIE_PUBLIC_URL={{ collie_instance.origin }}
COLLIE_STATE_DIR={{ remote_access_home }}/.local/state/valarmorghulis/{{ collie_instance.name }}
HERDR_SOCKET_PATH={{ remote_access_home }}/.config/herdr/herdr.sock
{% if collie_instance.public | default(false) | bool %}
COLLIE_ACCESS_TEAM={{ collie_instance.access_team }}
COLLIE_ACCESS_AUD={{ collie_instance.access_aud }}
{% endif %}
