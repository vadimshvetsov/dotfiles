{
  // Lint every tracked Markdown file. Run with a bare `npx markdownlint-cli2`.
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    ".ansible/**",
    // tpm clones plugins into the linked ~/.config/tmux, so they land here.
    "home/.config/tmux/plugins/**",
    // A one-line @AGENTS.md import, not prose.
    "CLAUDE.md"
  ],
  "config": {
    "MD013": false
  }
}
